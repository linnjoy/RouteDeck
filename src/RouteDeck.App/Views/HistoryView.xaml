<UserControl x:Class="RouteDeck.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:RouteDeck.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:HistoryViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="操作历史" Style="{StaticResource SectionTitle}" />
                <TextBlock Style="{StaticResource Muted}"
                           Text="撤销只会改回 RouteDeck 自己写入的内容。如果某一项之后被其他程序（如 Clash、Tailscale）或手动改过，会标为冲突并保留现状。" />
            </StackPanel>
            <ui:Button HorizontalAlignment="Right" VerticalAlignment="Top" Content="刷新" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RefreshCommand}" />
        </Grid>
        <TextBlock Grid.Row="1" Text="{Binding Note}" Style="{StaticResource Muted}"
                   Visibility="{Binding Note, Converter={StaticResource NullToVisibility}}" />
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Operations}">
            <ItemsControl.Template>
                <ControlTemplate>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:OperationRow}">
                    <Border Margin="0,0,0,6" Padding="12,8" CornerRadius="6" BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Id}" Style="{StaticResource Muted}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Time}" />
                                <TextBlock Text="{Binding Origin}" Style="{StaticResource Muted}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding Description}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Steps}" Style="{StaticResource Muted}" />
                                <TextBlock Text="{Binding Error}" Foreground="#E24B4A" TextWrapping="Wrap"
                                           Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}" />
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="{Binding Status}" VerticalAlignment="Center" />
                            <ui:Button Grid.Column="4" Content="撤销…" Icon="{ui:SymbolIcon ArrowUndo24}" VerticalAlignment="Center"
                                       Command="{Binding UndoCommand}"
                                       Visibility="{Binding CanUndo, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
