<UserControl x:Class="RouteDeck.App.Views.RoutesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:RouteDeck.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:RoutesViewModel}">
    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding AddCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding FocusFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
    </UserControl.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Diagnostics -->
        <ItemsControl Grid.Row="0" ItemsSource="{Binding FindingItems}" Margin="0,0,0,8">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:FindingItem}">
                    <Border Margin="0,0,0,6" Padding="12,8" CornerRadius="6" BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon FontSize="20" Margin="0,2,10,0" VerticalAlignment="Top">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Symbol" Value="Info24" />
                                        <Setter Property="Foreground" Value="#378ADD" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                <Setter Property="Symbol" Value="Warning24" />
                                                <Setter Property="Foreground" Value="#BA7517" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                <Setter Property="Symbol" Value="DismissCircle24" />
                                                <Setter Property="Foreground" Value="#E24B4A" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <ui:Button Content="让某个目标绕过隧道" Margin="0,0,6,0" Command="{Binding BypassCommand}"
                                           Visibility="{Binding CanBypass, Converter={StaticResource BoolToVisibility}}" />
                                <ui:Button Content="{Binding FixLabel}" Margin="0,0,6,0" Command="{Binding FixCommand}"
                                           Visibility="{Binding HasFix, Converter={StaticResource BoolToVisibility}}" />
                                <ui:Button Content="忽略" Appearance="Transparent" Command="{Binding DismissCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox x:Name="FilterBox" PlaceholderText="过滤（Ctrl+F）" Icon="{ui:SymbolIcon Search24}" VerticalAlignment="Center"
                        Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <RadioButton Content="IPv4" Margin="0,0,8,0" IsChecked="{Binding ShowIPv6, Converter={x:Static vm:Converters.Not}}" />
                <RadioButton Content="IPv6" Margin="0,0,16,0" IsChecked="{Binding ShowIPv6}" />
                <ui:ToggleSwitch Content="显示系统内置路由" IsChecked="{Binding ShowSystemRoutes}" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding Summary}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="16,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}" />
            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <ui:Button Content="绕过隧道直连…" Icon="{ui:SymbolIcon Branch24}" Margin="0,0,6,0" Command="{Binding ShowBypassCommand}" />
                <ui:Button Content="导出" Icon="{ui:SymbolIcon Save24}" Command="{Binding ExportCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <DataGrid ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False"
                      IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="None"
                      CanUserAddRows="False" CanUserDeleteRows="False" RowHeight="32" VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                <DataGrid.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditCommand}" />
                </DataGrid.InputBindings>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="编辑" Command="{Binding EditCommand}" />
                        <MenuItem Header="删除" Command="{Binding DeleteCommand}" />
                        <Separator />
                        <MenuItem Header="复制为 route add 命令" Command="{Binding CopyRouteAddCommand}" />
                        <MenuItem Header="复制为 PowerShell 命令" Command="{Binding CopyPowerShellCommand}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GroupItem">
                                            <Expander IsExpanded="{Binding Items[0].AdapterUp, Mode=OneTime}" Margin="0,4,0,0">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="10" Height="10" Fill="{Binding Items[0].Color}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding ItemCount, StringFormat=（{0} 条）}" Style="{StaticResource Muted}" Margin="6,0,0,0" />
                                                    </StackPanel>
                                                </Expander.Header>
                                                <ItemsPresenter />
                                            </Expander>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="32">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:RouteRow}">
                                <Grid>
                                    <ui:SymbolIcon Symbol="Globe24" FontSize="14" ToolTip="默认路由" Foreground="#BA7517"
                                                   Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}" />
                                    <ui:SymbolIcon Symbol="Warning24" FontSize="14" ToolTip="有需要注意的诊断提示" Foreground="#D85A30"
                                                   Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" />
                                    <ui:SymbolIcon Symbol="Info24" FontSize="14" ToolTip="有诊断信息" Foreground="#378ADD"
                                                   Visibility="{Binding HasInfoOnly, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="目标" Width="2*" SortMemberPath="Destination">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:RouteRow}">
                                <TextBlock Text="{Binding Destination}" Style="{StaticResource Mono}" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="网关" Width="2*" SortMemberPath="Gateway">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:RouteRow}">
                                <TextBlock Text="{Binding Gateway}" Style="{StaticResource Mono}" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="有效跃点" Width="80" SortMemberPath="EffectiveMetric">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:RouteRow}">
                                <TextBlock Text="{Binding EffectiveMetric}" VerticalAlignment="Center" ToolTip="{Binding MetricFormula}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="来源" Width="*" SortMemberPath="SourceLabel">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:RouteRow}">
                                <Border Style="{StaticResource Tag}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SourceLabel}" FontSize="12" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Details -->
            <Border Grid.Column="1" Margin="12,0,0,0" Padding="14" CornerRadius="6" BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <TextBlock Text="选择一条路由查看详情。双击可编辑。" Style="{StaticResource Muted}"
                               Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Selected}"
                                  Visibility="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel d:DataContext="{d:DesignInstance vm:RouteRow}">
                            <TextBlock Text="{Binding Destination}" FontSize="18" FontWeight="SemiBold" Style="{StaticResource Mono}" />
                            <TextBlock Text="{Binding StoreLabel}" Style="{StaticResource Muted}" Margin="0,2,0,12" />

                            <TextBlock Text="网卡" Style="{StaticResource Muted}" />
                            <TextBlock Text="{Binding Adapter.Name, FallbackValue=未知网卡}" Margin="0,0,0,8" />
                            <TextBlock Text="网关" Style="{StaticResource Muted}" />
                            <TextBlock Text="{Binding Gateway}" Style="{StaticResource Mono}" Margin="0,0,0,8" />
                            <TextBlock Text="有效跃点（路由 + 网卡）" Style="{StaticResource Muted}" />
                            <TextBlock Text="{Binding MetricFormula}" Margin="0,0,0,8" />
                            <TextBlock Text="来源" Style="{StaticResource Muted}" />
                            <TextBlock Text="{Binding SourceLabel}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding OwnerNote}" Style="{StaticResource Muted}" Margin="0,0,0,16" />

                            <WrapPanel>
                                <ui:Button Content="编辑" Icon="{ui:SymbolIcon Edit24}" Margin="0,0,6,6"
                                           Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <ui:Button Content="删除" Icon="{ui:SymbolIcon Delete24}" Margin="0,0,6,6"
                                           Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <ui:Button Content="复制 route add" Icon="{ui:SymbolIcon Copy24}" Margin="0,0,6,6"
                                           Command="{Binding DataContext.CopyRouteAddCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <ui:Button Content="复制 PowerShell" Icon="{ui:SymbolIcon Copy24}" Margin="0,0,6,6"
                                           Command="{Binding DataContext.CopyPowerShellCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
